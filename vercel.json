{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/gateway.mjs": { "maxDuration": 30 } },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/gateway?__trace_path=/api/:path*"
    },
    {
      "source": "/artifacts/:path*",
      "destination": "/api/gateway?__trace_path=/artifacts/:path*"
    },
    { "source": "/demo", "destination": "/api/gateway?__trace_path=/demo" },
    {
      "source": "/demo/:path*",
      "destination": "/api/gateway?__trace_path=/demo/:path*"
    }
  ]
}
